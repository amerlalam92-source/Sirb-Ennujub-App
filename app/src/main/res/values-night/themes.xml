<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (Night) -->
    <style name="Theme.ScoutLeader" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- AndroidX SplashScreen theme (Night - consistent white system splash) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/Theme.ScoutLeader</item>
    </style>
</resources>
