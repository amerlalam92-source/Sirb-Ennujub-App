<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_settings_cache.xml" />
        <exclude domain="sharedpref" path="branding_prefs.xml" />
        <exclude domain="sharedpref" path="app_migrations.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_settings_cache.xml" />
        <exclude domain="sharedpref" path="branding_prefs.xml" />
        <exclude domain="sharedpref" path="app_migrations.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
