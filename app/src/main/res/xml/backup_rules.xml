<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude app settings cache, branding cache, and Firebase local caches/auth prefs -->
    <exclude domain="sharedpref" path="app_settings_cache.xml" />
    <exclude domain="sharedpref" path="branding_prefs.xml" />
    <exclude domain="sharedpref" path="app_migrations.xml" />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
